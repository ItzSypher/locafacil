# Copie para `.env.local` e preencha. Nenhuma destas variáveis usa o prefixo
# VITE_, de propósito: o prefixo publicaria o valor no bundle do cliente.
# Em produção, cadastre as mesmas chaves no painel da Vercel.

# ===== API OTA (JCompany / SGLOC) =====
# Base da API. Cada locadora tem o próprio subdomínio: o da Locafácil é
# `locafacil.`; `sgloc.` é o tenant de demonstração da JCompany.
OTA_BASE_URL=https://locafacil.apijcompany.com.br

# Credenciais OAuth2 client_credentials, fornecidas pela JCompany depois que a
# conta da Locafacil for provisionada. Enquanto estiverem vazias, os endpoints
# autenticados respondem com as fixtures de api/_lib/mockData.js e marcam
# `demo: true` — o site funciona inteiro, com dados de exemplo.
OTA_CLIENT_ID=
OTA_CLIENT_SECRET=

# Alternativa ao par acima: um token Bearer já emitido pela JCompany, usado
# como veio. Se preenchido, tem prioridade sobre OTA_CLIENT_ID/SECRET.
OTA_ACCESS_TOKEN=

# ===== Retornos da homologação (/doc/cliente, /doc/marketing) =====
# Token do Vercel Blob privado `locafacil-retornos`. Em produção a Vercel cria
# sozinha quando o store é ligado ao projeto. Sem ele, os retornos ficam só no
# navegador de quem respondeu e a página avisa "Salvo neste navegador".
BLOB_READ_WRITE_TOKEN=

# Senha da página /doc/retornos, que lista o que cada pessoa marcou e escreveu.
# Em produção fica na Vercel como variável sensitive.
DOC_RETORNOS_SENHA=
