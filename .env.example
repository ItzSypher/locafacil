# Copie para `.env.local` e preencha. Nenhuma destas variáveis usa o prefixo
# VITE_, de propósito: o prefixo publicaria o valor no bundle do cliente.
# Em produção, cadastre as mesmas chaves no painel da Vercel.

# ===== API OTA (JCompany / SGLOC) =====
# Base da API. O valor abaixo é o de produção da JCompany.
OTA_BASE_URL=https://sgloc.apijcompany.com.br

# Credenciais OAuth2 client_credentials, fornecidas pela JCompany depois que a
# conta da Locafacil for provisionada. Enquanto estiverem vazias, os endpoints
# autenticados respondem com as fixtures de api/_lib/mockData.js e marcam
# `demo: true` — o site funciona inteiro, com dados de exemplo.
OTA_CLIENT_ID=
OTA_CLIENT_SECRET=

# ===== Assistente Locagora (opcional) =====
# Chave do Google AI Studio que alimenta o chat da Locagora, via
# api/agent-chat.js. Sem ela o endpoint responde 200 com `unavailable: true` e
# o assistente encaminha a conversa para o WhatsApp — o site não quebra.
# Se você não quer o assistente por IA, deixe em branco.
GEMINI_API_KEY=
